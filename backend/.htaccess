# Deny direct access to config and uploads
<FilesMatch "^(config\.php|bootstrap\.php|schema\.sql)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^uploads/ - [F,L]
</IfModule>

# Increase upload limits (adjust to your cPanel plan)
<IfModule mod_php.c>
  php_value upload_max_filesize 25M
  php_value post_max_size 26M
</IfModule>
